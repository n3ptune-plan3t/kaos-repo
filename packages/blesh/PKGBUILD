pkgname=blesh
_pkgname=ble.sh
pkgver=0.3.4
pkgrel=1
pkgdesc="Bash Line Editor (ble.sh) -- a replacement for Bash's line editor with enhanced features"
arch=('any')
url='https://github.com/akinomyoga/ble.sh'
license=('BSD-3-Clause')
depends=('bash')
options=('!strip')
source=("https://github.com/akinomyoga/ble.sh/releases/download/v${pkgver}/ble-${pkgver}.tar.xz")
sha256sums=('e543a43d211fef8f52b96b2e7935e892581421f759cda4ae87563854ebc60573')

package() {
  install -d "${pkgdir}/usr/share/blesh"
  cp -RpT "${srcdir}/ble-${pkgver}" "${pkgdir}/usr/share/blesh"
}