_pkgname=qt6ct
pkgname=qt6ct-kde
pkgver=0.11
pkgrel=9
pkgdesc='Program that allows users to configure Qt6 settings (theme, font, icons, etc.) under a DE/WM without Qt integration.'
arch=('x86_64')
url='https://www.opencode.net/trialuser/qt6ct'
license=('BSD-2-Clause')
depends=('plasma-integration' 'qt6-svg')
makedepends=('cmake' 'qt6-tools')
conflicts=($_pkgname)
provides=($_pkgname)
source=("https://www.opencode.net/trialuser/qt6ct/-/archive/${pkgver}/${_pkgname}-${pkgver}.tar.bz2"
        "${_pkgname}-shenanigans.patch"
        "kdeglobal-shenanigans.patch")
sha256sums=('c26bc87b8e1603e194f9793db58667722672a6c26dfc0e080a4b2afe35fe2583'
            'baab2b714ad490de3a12edd5d4ec0f6223eded034d66a694989e746b86d1f420'
            '22dc318236b116a54266b53e460a3a62b606750c3b6d8cc7e529c52a18722031')

prepare() {
  cd "${srcdir}/${_pkgname}-${pkgver}"
  patch -Np1 -i "${srcdir}/${_pkgname}-shenanigans.patch"
  patch -Np2 -i "${srcdir}/kdeglobal-shenanigans.patch"
}

build() {
  cmake -B build -S ${_pkgname}-${pkgver} \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR=${pkgdir} cmake --install build
  install -Dm644 ${_pkgname}-${pkgver}/COPYING ${pkgdir}/usr/share/licenses/${pkgname}/LICENSE
}
