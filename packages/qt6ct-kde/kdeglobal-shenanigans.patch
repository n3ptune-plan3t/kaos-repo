+#ifndef KCOLORSCHEMEFILL_H
+#define KCOLORSCHEMEFILL_H
+
+#if defined KF_CONFIGCORE_LIB && defined KF_COLORSCHEME_LIB
+#include <QMap>
+#include <QString>
+#include <QStringList>
+#include <KConfig>
+#include <KConfigGroup>
+#include <KSharedConfig>
+
+//Loads a KColorScheme (.colors) file into an anonymous in-memory config and fills in what the file
+//leaves out, so that KColorScheme does not fall back to its built-in blue defaults:
+// - a missing Complementary group is taken from Tooltip (or Window); KColorScheme already derives
+//   Header from Window by itself
+// - a missing DecorationFocus / DecorationHover is taken from the other one of the same group, then
+//   from Window / View / Button, then from the scheme's Selection background (its accent color)
+//The file itself is never modified.
+namespace Qt6CTColors
+{
+inline void copyGroupRecursive(const KConfigGroup &src, KConfigGroup dst)
+{
+    const QMap<QString, QString> entries = src.entryMap();
+    for(auto it = entries.cbegin(); it != entries.cend(); ++it)
+        dst.writeEntry(it.key().toUtf8().constData(), it.value());
+    for(const QString &sub : src.groupList())
+        copyGroupRecursive(src.group(sub), dst.group(sub));
+}
+
+inline QString readKey(const KSharedConfigPtr &c, const QString &group, const char *key)
+{
+    return KConfigGroup(c, group).readEntry(key, QString());
+}
+
+inline void fillMissingColors(const KSharedConfigPtr &c)
+{
+    const QStringList groups = c->groupList();
+    auto has = [&](const char *g) { return groups.contains(QLatin1String(g)); };
+
+    QStringList donors;
+    for(const char *g : { "Colors:Window", "Colors:View", "Colors:Button" })
+        if(has(g))
+            donors << QLatin1String(g);
+    if(donors.isEmpty())
+        return; //nothing sensible to derive from
+
+    //whole groups that are optional in practice
+    if(!has("Colors:Complementary"))
+        copyGroupRecursive(KConfigGroup(c, has("Colors:Tooltip") ? "Colors:Tooltip" : "Colors:Window"),
+                           KConfigGroup(c, "Colors:Complementary"));
+
+    //hover / focus decoration colors of every set
+    QString accent;
+    if(has("Colors:Selection"))
+        accent = readKey(c, QStringLiteral("Colors:Selection"), "BackgroundNormal");
+
+    auto fillDecoration = [&](KConfigGroup g, const QStringList &from) {
+        const char *keys[2] = { "DecorationFocus", "DecorationHover" };
+        const char *sibling[2] = { "DecorationHover", "DecorationFocus" };
+        for(int i = 0; i < 2; ++i)
+        {
+            if(!g.readEntry(keys[i], QString()).isEmpty())
+                continue;
+            QString v = g.readEntry(sibling[i], QString()); //same group first
+            for(int j = 0; v.isEmpty() && j < from.count(); ++j)
+                v = readKey(c, from.at(j), keys[i]);
+            for(int j = 0; v.isEmpty() && j < from.count(); ++j)
+                v = readKey(c, from.at(j), sibling[i]);
+            if(v.isEmpty())
+                v = accent;
+            if(!v.isEmpty())
+                g.writeEntry(keys[i], v);
+        }
+    };
+    for(const QString &name : donors) //donors first, so that the others can follow them
+    {
+        QStringList others = donors;
+        others.removeAll(name);
+        fillDecoration(KConfigGroup(c, name), others);
+    }
+    for(const char *g : { "Colors:Selection", "Colors:Tooltip", "Colors:Complementary" })
+        if(c->groupList().contains(QLatin1String(g)))
+            fillDecoration(KConfigGroup(c, g), donors);
+}
+
+inline KSharedConfigPtr loadCompletedColorScheme(const QString &filePath)
+{
+    //anonymous configs are cached and shared, so drop what a previous load left in it
+    KSharedConfigPtr out = KSharedConfig::openConfig(QString(), KConfig::SimpleConfig);
+    for(const QString &g : out->groupList())
+        out->deleteGroup(g);
+
+    KConfig src(filePath, KConfig::SimpleConfig);
+    for(const QString &g : src.groupList())
+        copyGroupRecursive(KConfigGroup(&src, g), KConfigGroup(out, g));
+    fillMissingColors(out);
+    return out;
+}
+}
+#endif
+#endif
