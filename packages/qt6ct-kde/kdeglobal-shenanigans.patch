+++ b/src/qt6ct-common/kcolorschemeload.h
@@ -0,0 +1,50 @@
+#ifndef KCOLORSCHEMELOAD_H
+#define KCOLORSCHEMELOAD_H
+
+#if defined KF_CONFIGCORE_LIB && defined KF_COLORSCHEME_LIB
+#include <QMap>
+#include <QProcess>
+#include <QString>
+#include <QStringList>
+#include <KConfig>
+#include <KConfigGroup>
+#include <KSharedConfig>
+
+//Helpers for KColorScheme (.colors) files. Nothing is filled in for what a scheme leaves out:
+//KColorScheme falls back to its own defaults for that.
+namespace Qt6CTColors
+{
+//Opens a .colors file on its own. SimpleConfig keeps kdeglobals out of it, so keys missing from the
+//file are not answered by whatever another scheme left in kdeglobals. One config per file, nothing
+//shared between different schemes; reparse so a file edited on disk is not served from the cache.
+inline KSharedConfigPtr loadColorScheme(const QString &filePath)
+{
+    KSharedConfigPtr c = KSharedConfig::openConfig(filePath, KConfig::SimpleConfig);
+    c->reparseConfiguration();
+    return c;
+}
+
+inline void copyGroupRecursive(const KConfigGroup &src, KConfigGroup dst)
+{
+    const QMap<QString, QString> entries = src.entryMap();
+    for(auto it = entries.cbegin(); it != entries.cend(); ++it)
+        dst.writeEntry(it.key().toUtf8().constData(), it.value());
+    for(const QString &sub : src.groupList())
+        copyGroupRecursive(src.group(sub), dst.group(sub));
+}
+
+//Tells running apps that kdeglobals changed: the signal Oxygen listens to (the one oxygen-settings sends)
+//and KDE's palette-changed notification. dbus-send is used so that no QtDBus link dependency is needed.
+inline void notifyColorSchemeChanged()
+{
+    QProcess::startDetached(QStringLiteral("dbus-send"),
+        { QStringLiteral("--session"), QStringLiteral("--type=signal"), QStringLiteral("/OxygenStyle"),
+          QStringLiteral("org.kde.Oxygen.Style.reparseConfiguration") });
+    QProcess::startDetached(QStringLiteral("dbus-send"),
+        { QStringLiteral("--session"), QStringLiteral("--type=signal"), QStringLiteral("/KGlobalSettings"),
+          QStringLiteral("org.kde.KGlobalSettings.notifyChange"),
+          QStringLiteral("int32:0"), QStringLiteral("int32:0") });
+}
+}
+#endif
+#endif
