pkgname=python3-snowballstemmer
_pkgname=snowballstemmer
pkgver=3.1.1
pkgrel=1
pkgdesc='Snowball stemming algorithms (pure Python), required by Sphinx'
url='https://github.com/snowballstem/snowball'
arch=(any)
license=(BSD-3-Clause)
depends=(python3)
makedepends=(python3-build python3-installer python3-setuptools python3-wheel)
source=("https://files.pythonhosted.org/packages/source/s/${_pkgname}/${_pkgname}-${pkgver}.tar.gz")
sha256sums=('e07bbc54a0d798fe6010a12398422e62a8bfbba95c394fd0956ef58cb4d3e260')

build() {
  cd ${_pkgname}-${pkgver}

  python3 -m build --wheel --no-isolation
}

package() {
  cd ${_pkgname}-${pkgver}

  python3 -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 COPYING -t "$pkgdir/usr/share/licenses/${pkgname}/"
}
