pkgname=mango
pkgver=0.19.4
pkgrel=2
pkgdesc='Practical, lightweight dwl-based Wayland compositor'
arch=('x86_64')
url='https://github.com/mangowm/mango'
license=('GPL3')
depends=('wlroots' 'scenefx' 'cjson' 'wayland' 'libdrm' 'libinput' 'libxkbcommon'
         'pcre2' 'pixman' 'pango' 'cairo' 'libglvnd' 'libxcb' 'xcb-util-wm'
         'xwayland' 'xdg-desktop-portal-wlr')
makedepends=('meson' 'ninja' 'wayland-protocols' 'pkg-config')
source=("$pkgname-$pkgver.tar.gz::https://github.com/mangowm/mango/archive/refs/tags/$pkgver.tar.gz")
sha256sums=('c4573ab52e76d38850d2b5e6982fcf16ee1f664cb327bd88a5b05f26676642fa')

build() {
  meson setup build "$pkgname-$pkgver" \
    --prefix=/usr \
    --sysconfdir=/etc \
    --libdir=lib \
    --buildtype=release \
    -Dxwayland=enabled
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm644 "$pkgname-$pkgver/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -Dm644 "$pkgname-$pkgver/assets/mango.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/mango.svg"
}
